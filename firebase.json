{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*"],
    "predeploy": ["node match-functions/scripts/sync-shared.js"],
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "matchApi", "region": "us-central1" } },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "**/*.@(js|css)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "functions": [
    {
      "source": "match-functions",
      "codebase": "match",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "tests", "dev.js", "scripts", "README.md", "*.log", ".env*", ".secret.local"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
